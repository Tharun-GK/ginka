# Optional public-source API settings
GITHUB_TOKEN=
ARXIV_RESULTS=15
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=20
JOB_RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss
NEWS_RSS_FEEDS=https://feeds.arstechnica.com/arstechnica/technology-lab

# Optional LLM providers (fallback order: Gemini, Groq, DeepSeek)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional Google Sheets export
GOOGLE_CREDENTIALS_FILE=
SPREADSHEET_ID=

# Local use defaults to SQLite. Set persistent PostgreSQL for Vercel deployments.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required to enable collector and Google Sheets actions in a public deployment.
# Use a long randomly generated session secret; keep both values out of Git.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
